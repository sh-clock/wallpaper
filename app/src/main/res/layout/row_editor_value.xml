<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/linear_editor_value"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:minHeight="64dp"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:paddingHorizontal="16dp"
  android:background="?attr/selectableItemBackground">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_weight="1">

    <TextView
      android:id="@+id/text_editor_value_label"
      style="@style/Widget.Doodle.TextView.ListItem.Title" />

    <TextView
      android:id="@+id/text_editor_value_summary"
      style="@style/Widget.Doodle.TextView.ListItem.Description" />

  </LinearLayout>

  <ImageView
    android:id="@+id/image_editor_value_chevron"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:src="@drawable/ic_rounded_chevron_right"
    app:tint="?attr/colorOnSurfaceVariant"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="ContentDescription" />

</LinearLayout>
