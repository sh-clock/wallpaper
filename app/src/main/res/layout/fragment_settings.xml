<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:transitionGroup="true"
  android:background="?attr/colorSurface">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar_settings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar_settings"
      style="@style/Widget.Doodle.Toolbar.Back"
      app:title="@string/sh1_title_settings"
      app:menu="@menu/menu_main" />

  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraint_settings"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingTop="16dp"
      android:paddingBottom="8dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/max_content_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- v10.0 Task 1: the Camtrack editor entry MOVED to the main menu
             (fragment_overview.xml) — this page keeps the presentation
             controls only. -->
        <LinearLayout
          android:id="@+id/linear_environment_resolution"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_resolution"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_zoom_out_map_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_resolution" />

            <TextView
              android:id="@+id/text_environment_resolution_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_resolution_description" />

          </LinearLayout>

          <com.google.android.material.button.MaterialButton
            android:id="@+id/button_environment_resolution_reset"
            style="@style/Widget.Doodle.Button.TextButton"
            android:text="@string/sh1_reset"
            android:minWidth="0dp"
            tools:ignore="TouchTargetSizeCheck,DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <com.google.android.material.slider.Slider
          android:id="@+id/slider_environment_resolution"
          style="@style/Widget.Doodle.Slider"
          android:layout_marginStart="68dp"
          android:layout_marginEnd="20dp"
          android:valueFrom="0"
          android:valueTo="6"
          android:stepSize="1"
          tools:ignore="DuplicateSpeakableTextCheck" />

        <!-- v10.0 Task 3: the PS1 ordered-dither toggle. The AUTO rule:
             ON at the native 320x224 raster (authentic), OFF at every
             higher resolution (the scaled dither grid looks unnatural);
             an explicit user choice here is respected at any resolution
             (Sh1WallpaperService.getEffectiveDither). -->
        <LinearLayout
          android:id="@+id/linear_environment_dither"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_dither"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_filter_b_and_w"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_dither" />

            <TextView
              android:id="@+id/text_environment_dither_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_dither_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_dither"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_fps"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_fps"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_animation_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_fps" />

            <TextView
              android:id="@+id/text_environment_fps_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_fps_description" />

          </LinearLayout>

          <com.google.android.material.button.MaterialButton
            android:id="@+id/button_environment_fps_reset"
            style="@style/Widget.Doodle.Button.TextButton"
            android:text="@string/sh1_reset"
            android:minWidth="0dp"
            tools:ignore="TouchTargetSizeCheck,DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <com.google.android.material.slider.Slider
          android:id="@+id/slider_environment_fps"
          style="@style/Widget.Doodle.Slider"
          android:layout_marginStart="68dp"
          android:layout_marginEnd="20dp"
          android:valueFrom="1"
          android:valueTo="60"
          android:stepSize="1"
          tools:ignore="DuplicateSpeakableTextCheck" />

        <!-- v10.1 TASK 4: the crop-window pan. The presentation is a
             STRICT CENTER-CROP (aspect fill — never stretched, never
             letterboxed); these offsets shift the visible window inside
             the framebuffer. The axis that fills the screen exactly has
             no room: portrait phones pan X, landscape screens pan Y.
             Live-applied — no engine restart (the presentation blit
             reads the offsets every frame). -->
        <LinearLayout
          android:id="@+id/linear_environment_crop_x"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_crop_x"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_drag_pan_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_crop_x" />

            <TextView
              android:id="@+id/text_environment_crop_x_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_crop_x_description" />

          </LinearLayout>

          <com.google.android.material.button.MaterialButton
            android:id="@+id/button_environment_crop_x_reset"
            style="@style/Widget.Doodle.Button.TextButton"
            android:text="@string/sh1_reset"
            android:minWidth="0dp"
            tools:ignore="TouchTargetSizeCheck,DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <com.google.android.material.slider.Slider
          android:id="@+id/slider_environment_crop_x"
          style="@style/Widget.Doodle.Slider"
          android:layout_marginStart="68dp"
          android:layout_marginEnd="20dp"
          android:valueFrom="-1"
          android:valueTo="1"
          tools:ignore="DuplicateSpeakableTextCheck" />

        <LinearLayout
          android:id="@+id/linear_environment_crop_y"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_crop_y"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_zoom_out_map_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_crop_y" />

            <TextView
              android:id="@+id/text_environment_crop_y_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_crop_y_description" />

          </LinearLayout>

          <com.google.android.material.button.MaterialButton
            android:id="@+id/button_environment_crop_y_reset"
            style="@style/Widget.Doodle.Button.TextButton"
            android:text="@string/sh1_reset"
            android:minWidth="0dp"
            tools:ignore="TouchTargetSizeCheck,DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <com.google.android.material.slider.Slider
          android:id="@+id/slider_environment_crop_y"
          style="@style/Widget.Doodle.Slider"
          android:layout_marginStart="68dp"
          android:layout_marginEnd="20dp"
          android:valueFrom="-1"
          android:valueTo="1"
          tools:ignore="DuplicateSpeakableTextCheck" />

<TextView
          style="@style/Widget.Doodle.TextView.Category"
          android:text="@string/sh1_auto_section" />

        <LinearLayout
          android:id="@+id/linear_environment_auto"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_auto"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_rotate_auto_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_auto_mode" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_auto_mode_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_auto"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_current"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_current"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_dark_mode_to_light_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_current_mode" />

            <TextView
              android:id="@+id/text_environment_current"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_current_mode_day" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_transition"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_transition"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_animation_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_transition" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_transition_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_transition"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_sun_mode"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_sun_mode"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_looks"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_sun_mode" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_sun_mode_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_sun_mode"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_city"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_city"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_language_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_city" />

            <TextView
              android:id="@+id/text_environment_city_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_city_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_day"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_day"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_light_mode_to_dark_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_day_time" />

            <TextView
              android:id="@+id/text_environment_day_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_day_time_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_night"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_night"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_dark_mode_to_light_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_night_time" />

            <TextView
              android:id="@+id/text_environment_night_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_night_time_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_auto_preset"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_auto_preset"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_palette_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_auto_preset" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_auto_preset_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_auto_preset"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_auto_day"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_auto_day"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_dark_mode_to_light_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_auto_day" />

            <TextView
              android:id="@+id/text_environment_auto_day_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_auto_day_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_auto_night"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_auto_night"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_light_mode_to_dark_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_auto_night" />

            <TextView
              android:id="@+id/text_environment_auto_night_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_auto_night_description" />

          </LinearLayout>

        </LinearLayout>
      </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
