<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/linear_sh1_cities_container"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
      android:id="@+id/text_sh1_cities_title"
      style="@style/Widget.Doodle.TextView.Toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAlignment="center"
      android:gravity="center_horizontal"
      android:singleLine="true" />

    <TextView
      android:id="@+id/text_sh1_cities_description"
      style="@style/Widget.Doodle.TextView.Paragraph.BodyMedium"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="?attr/colorOnSurfaceVariant"
      android:paddingTop="4dp" />

    <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/layout_sh1_cities_search"
      style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:hint="@string/sh1_city_search_hint">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/edit_sh1_cities_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:imeOptions="actionSearch"
        android:inputType="text|textCapSentences|textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    </com.google.android.material.textfield.TextInputLayout>

  </LinearLayout>

  <com.google.android.material.divider.MaterialDivider
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <!-- v9.1 Fix 2: manual latitude/longitude fallback (feeds the NOAA
       algorithm directly, overriding the city database) -->
  <LinearLayout
    android:id="@+id/linear_sh1_cities_custom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackgroundBorderless">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginStart="20dp"
      android:layout_marginEnd="20dp"
      android:src="@drawable/ic_rounded_tune_anim"
      app:tint="?attr/colorOnSurfaceVariant"
      tools:ignore="ContentDescription" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="16dp"
      android:orientation="vertical"
      android:layout_weight="1">

      <TextView
        android:id="@+id/text_sh1_cities_custom_title"
        style="@style/Widget.Doodle.TextView.ListItem.Title"
        android:text="@string/sh1_city_custom" />

      <TextView
        android:id="@+id/text_sh1_cities_custom_summary"
        style="@style/Widget.Doodle.TextView.ListItem.Description"
        android:text="@string/sh1_city_custom_summary" />

    </LinearLayout>

  </LinearLayout>

  <!-- v9.1 Fix 2: clear the location -> fall back to the device schedule -->
  <LinearLayout
    android:id="@+id/linear_sh1_cities_none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackgroundBorderless">

    <ImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginStart="20dp"
      android:layout_marginEnd="20dp"
      android:src="@drawable/ic_rounded_close"
      app:tint="?attr/colorOnSurfaceVariant"
      tools:ignore="ContentDescription" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginEnd="16dp"
      android:orientation="vertical"
      android:layout_weight="1">

      <TextView
        style="@style/Widget.Doodle.TextView.ListItem.Title"
        android:text="@string/sh1_city_none" />

      <TextView
        style="@style/Widget.Doodle.TextView.ListItem.Description"
        android:text="@string/sh1_city_none_summary" />

    </LinearLayout>

  </LinearLayout>

  <com.google.android.material.divider.MaterialDivider
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recycler_sh1_cities"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none" />

</LinearLayout>
