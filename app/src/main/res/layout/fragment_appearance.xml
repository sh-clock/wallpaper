<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:transitionGroup="true"
  android:background="?attr/colorSurface">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar_appearance"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar_appearance"
      style="@style/Widget.Doodle.Toolbar.Back"
      app:title="@string/environment_title"
      app:menu="@menu/menu_main" />

  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_appearance"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraint_appearance"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingTop="16dp"
      android:paddingBottom="8dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/max_content_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Doodle.Card.Text"
          android:layout_marginStart="16dp"
          android:layout_marginEnd="16dp"
          android:layout_marginBottom="10dp"
          app:contentPaddingBottom="8dp"
          app:contentPaddingLeft="0dp"
          app:contentPaddingRight="0dp">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
              style="@style/Widget.Doodle.TextView.Paragraph"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginStart="16dp"
              android:layout_marginEnd="16dp"
              android:layout_marginBottom="4dp"
              android:textColor="?attr/colorOnSurfaceVariant"
              android:text="@string/sh1_environment_info" />

            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_gravity="end"
              android:paddingStart="12dp"
              android:paddingEnd="12dp">

              <com.google.android.material.button.MaterialButton
                android:id="@+id/button_environment_info"
                style="@style/Widget.Doodle.Button.TextButton"
                android:text="@string/action_learn_more" />

            </LinearLayout>

          </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
          android:id="@+id/linear_environment_scene"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_scene"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_wallpaper_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_scene" />

            <TextView
              android:id="@+id/text_environment_scene_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_scene_description" />

          </LinearLayout>

        </LinearLayout>


        <!-- v9.2 Feature 31: the Doodle-base wallpaper selector, re-introduced —
             a horizontally scrolling row of circular SelectionCardViews, one per
             individual camdat track (v9.2 Feature 30: every track IS one distinct
             wallpaper, even when several originate from the same file/model).
             The engine-rendered screenshot fills the circle completely
             (CENTER_CROP inside the circular MaterialCardView clip — no bars,
             no letterboxing). The inbuilt Doodle wallpapers are NOT included. -->
        <LinearLayout
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine"
          android:paddingTop="12dp"
          android:paddingBottom="0dp"
          android:paddingStart="16dp"
          android:paddingEnd="0dp"
          android:minHeight="0dp">

          <ImageView
            android:id="@+id/image_environment_wallpapers"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_wallpaper_anim"
            android:layout_marginTop="12dp"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_wallpaper_selector"
              android:paddingStart="0dp"
              android:paddingEnd="16dp" />

            <TextView
              android:id="@+id/text_environment_wallpapers_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:paddingStart="0dp"
              android:paddingEnd="16dp"
              android:text="@string/sh1_scene_description" />

            <HorizontalScrollView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:scrollbars="none"
              android:overScrollMode="ifContentScrolls"
              android:importantForAccessibility="no">

              <LinearLayout
                android:id="@+id/linear_environment_wallpaper_selector"
                style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                  android:id="@+id/linear_environment_wallpaper_circles"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal" />

              </LinearLayout>

            </HorizontalScrollView>

          </LinearLayout>

        </LinearLayout>


        <LinearLayout
          android:id="@+id/linear_environment_scene_day"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_scene_day"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_light_mode_to_dark_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_scene_day_env" />

            <TextView
              android:id="@+id/text_environment_scene_day_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_scene_day_env_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_scene_night"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_scene_night"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_dark_mode_to_light_mode_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_scene_night_env" />

            <TextView
              android:id="@+id/text_environment_scene_night_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_scene_night_env_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_overrides"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_overrides"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_filter_alt_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_overrides" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_overrides_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_overrides"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

<TextView
          style="@style/Widget.Doodle.TextView.Category"
          android:text="@string/sh1_env_defaults_section" />

        <LinearLayout
          android:id="@+id/linear_environment_mode"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_mode"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_looks"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_env_mode" />

            <TextView
              android:id="@+id/text_environment_mode_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_env_mode_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_weather"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_weather"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_animation_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_weather" />

            <TextView
              android:id="@+id/text_environment_weather_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_weather_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_wobble"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_wobble"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_straighten"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_wobble" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_wobble_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_wobble"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_thumbnails"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_thumbnails"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_filter_b_and_w"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_thumbnails" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_thumbnails_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_thumbnails"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

<TextView
          style="@style/Widget.Doodle.TextView.Category"
          android:text="@string/sh1_randomizer_section" />

        <LinearLayout
          android:id="@+id/linear_environment_randomizer"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_randomizer"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_shuffle_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_randomizer" />

            <TextView
              android:id="@+id/text_environment_randomizer_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_randomizer_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_interval"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable"
          android:visibility="gone">

          <ImageView
            android:id="@+id/image_environment_interval"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_timer_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_randomizer_interval" />

            <TextView
              android:id="@+id/text_environment_interval_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_randomizer_interval_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_shuffle"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_shuffle"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_shuffle_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_shuffle" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_shuffle_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_shuffle"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_favorites"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_favorites"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_star"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_favorites" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_favorites_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_favorites"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_prewarm"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_prewarm"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_refresh_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_prewarm" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_prewarm_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_prewarm"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>
      </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
