            android:id="@+id/image_environment_charging"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_battery_saver_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_charging" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_charging_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_charging"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_aod"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_aod"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_aod"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_aod" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_aod_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_aod"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_adaptive"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_adaptive"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_tune_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_adaptive" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_adaptive_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_adaptive"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <TextView
          style="@style/Widget.Doodle.TextView.Category"
          android:paddingTop="8dp"
          android:text="@string/sh1_data_section" />

        <LinearLayout
          android:id="@+id/linear_environment_config"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_config"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_tune_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_config" />

            <TextView
              android:id="@+id/text_environment_config_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_config_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_byoa"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_byoa"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_add"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_byoa" />

            <TextView
              android:id="@+id/text_environment_byoa_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_byoa_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_storage_guard"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_storage_guard"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_memory"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_storage_guard" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_storage_guard_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_storage_guard"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_watchdog"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_watchdog"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_bug_report"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_watchdog" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_watchdog_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_watchdog"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_backup"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_backup"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_share"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_backup" />

            <TextView
              android:id="@+id/text_environment_backup_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_backup_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_diagnostics"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_diagnostics"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_straighten"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_diagnostics" />

            <TextView
              android:id="@+id/text_environment_diagnostics_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_diagnostics_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_tiles"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_tiles"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_bolt"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_tiles" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_tiles_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_tiles"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_other_language"
        
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_other_language"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_language_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/other_language" />

            <TextView
              android:id="@+id/text_other_language"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_language_system" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.More"
          android:paddingTop="12dp"
          android:paddingBottom="4dp"
          android:minHeight="56dp">

          <ImageView
            android:id="@+id/image_other_theme"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_palette_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/other_theme"
              android:paddingStart="0dp"
              android:paddingEnd="16dp"/>

            <TextView
              android:id="@+id/text_appearance_colors_description"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_theme_description"
              android:paddingStart="0dp"
              android:paddingEnd="16dp"/>

          </LinearLayout>

        </LinearLayout>

        <HorizontalScrollView
          android:id="@+id/scroll_other_theme"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:scrollbars="none"
          android:overScrollMode="ifContentScrolls"
          android:layout_marginStart="56dp"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp">

          <LinearLayout
            android:id="@+id/linear_other_theme_container"
            style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="20dp" />

        </HorizontalScrollView>

        <HorizontalScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:scrollbars="none"
          android:overScrollMode="ifContentScrolls"
          android:layout_marginStart="56dp"
          android:layout_marginBottom="8dp">

          <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_other_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="24dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
              android:id="@+id/button_other_theme_auto"
              style="@style/Widget.Doodle.Button.OutlinedButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/other_theme_auto"
              tools:ignore="TextContrastCheck" />

            <com.google.android.material.button.MaterialButton
              android:id="@+id/button_other_theme_light"
              style="@style/Widget.Doodle.Button.OutlinedButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/other_theme_light"
              tools:ignore="TextContrastCheck" />

            <com.google.android.material.button.MaterialButton
              android:id="@+id/button_other_theme_dark"
              style="@style/Widget.Doodle.Button.OutlinedButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/other_theme_dark"
              tools:ignore="TextContrastCheck" />

          </com.google.android.material.button.MaterialButtonToggleGroup>

        </HorizontalScrollView>

        <LinearLayout
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine"
          android:paddingTop="12dp"
          android:paddingBottom="0dp"
          android:paddingStart="16dp"
          android:paddingEnd="0dp"
          android:minHeight="64dp">

          <ImageView
            android:id="@+id/image_settings_contrast"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_contrast_anim"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/other_contrast"
              android:paddingStart="0dp"
              android:paddingEnd="16dp"/>

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_contrast_description"
              android:paddingStart="0dp"
              android:paddingEnd="16dp"/>

            <TextView
              android:id="@+id/text_settings_contrast_dynamic"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_contrast_dynamic"
              android:textColor="?attr/colorError"
              android:paddingStart="0dp"
              android:paddingEnd="16dp" />

          </LinearLayout>

        </LinearLayout>

        <HorizontalScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:layout_marginBottom="4dp"
          android:layout_marginStart="56dp"
          android:scrollbars="none"
          android:overScrollMode="ifContentScrolls">

          <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_other_contrast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <Button
              android:id="@+id/button_other_contrast_standard"
              style="@style/Widget.Doodle.Button.OutlinedButton"
              android:text="@string/other_contrast_standard" />

            <Button
              android:id="@+id/button_other_contrast_medium"
              style="@style/Widget.Doodle.Button.OutlinedButton"
              android:text="@string/other_contrast_medium" />

            <Button
              android:id="@+id/button_other_contrast_high"
              style="@style/Widget.Doodle.Button.OutlinedButton"
              android:text="@string/other_contrast_high" />

          </com.google.android.material.button.MaterialButtonToggleGroup>

        </HorizontalScrollView>

        <LinearLayout
          android:id="@+id/linear_other_launcher"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable.More">

          <ImageView
            android:id="@+id/image_other_launcher"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_visibility_off"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/other_launcher" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_launcher_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_other_launcher"
            style="@style/Widget.Doodle.Switch" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_other_log"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable.More">

          <ImageView
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_bug_report"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/other_log" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_log_description" />

          </LinearLayout>

        </LinearLayout>

        <!-- v9.9: the RENDERING BACKEND picker — Software (the default
             and the accuracy source of truth) / OpenGL ES / Vulkan (both
             hardware, experimental opt-ins; the user OVERRULED the v9.8
             no-ship verdict: the hardware path ships at its measured
             99% bit-exact ceiling with the PS1 wobble + dither tables
             PERFECTLY preserved). Selecting a hardware backend first
             shows the mandated Material 3 experimental warning. The row
             shows the active backend; a change restarts the engine
             exactly like the resolution setting (the context is boot-time). -->
        <TextView
          style="@style/Widget.Doodle.TextView.Category"
          android:paddingTop="8dp"
          android:text="@string/sh1_rendering_section" />

        <LinearLayout
          android:id="@+id/linear_other_hwrender"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_tune_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_hwrender" />

            <TextView
              android:id="@+id/text_other_hwrender_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              tools:text="Active: Software (Default) — tap to change" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_other_reset"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable.More">

          <ImageView
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_reset_settings"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/other_reset" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/other_reset_description" />

          </LinearLayout>

        </LinearLayout>

      </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>