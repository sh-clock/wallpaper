<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:transitionGroup="true"
  android:background="?attr/colorSurface">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar_other"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar_other"
      style="@style/Widget.Doodle.Toolbar.Back"
      app:title="@string/other_title"
      app:menu="@menu/menu_main" />

  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_other"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraint_other"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingTop="8dp"
      android:paddingBottom="8dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/max_content_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
          style="@style/Widget.Doodle.TextView.Category"
          android:paddingTop="8dp"
          android:text="@string/sh1_battery_section" />

        <LinearLayout
          android:id="@+id/linear_environment_battery"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_battery"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_battery_saver_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_battery_critical" />

            <TextView
              android:id="@+id/text_environment_battery_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_battery_critical_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_mid_battery"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_mid_battery"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_battery_saver_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_mid_battery" />

            <TextView
              android:id="@+id/text_environment_mid_battery_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_mid_battery_description" />

          </LinearLayout>

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_halfrate"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_halfrate"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_timer_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_halfrate" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_halfrate_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_halfrate"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_power_save"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_power_save"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_aod"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_power_save" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_power_save_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_power_save"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
