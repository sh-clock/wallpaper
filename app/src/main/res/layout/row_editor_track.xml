<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/linear_editor_track_container"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:minHeight="72dp"
  android:gravity="center_vertical"
  android:background="?attr/selectableItemBackground">

  <ImageView
    android:id="@+id/image_editor_track_drag"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:padding="10dp"
    android:src="@drawable/ic_rounded_drag_handle"
    app:tint="?attr/colorOnSurfaceVariant"
    android:contentDescription="@string/sh1_camtrack_drag_handle" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:orientation="vertical"
    android:layout_weight="1">

    <TextView
      android:id="@+id/text_editor_track_name"
      style="@style/Widget.Doodle.TextView.ListItem.Title"
      tools:text="Line 1" />

    <TextView
      android:id="@+id/text_editor_track_sub"
      style="@style/Widget.Doodle.TextView.ListItem.Description"
      tools:text="LINE · 29.6 s · 1.7 m/s · snow w3" />

  </LinearLayout>

  <TextView
    android:id="@+id/text_editor_track_weather"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp"
    android:textSize="11sp"
    android:letterSpacing="0.04"
    android:textColor="?attr/colorOnSecondaryContainer"
    android:background="@drawable/shape_editor_chip"
    tools:text="snow w3" />

  <ImageView
    android:id="@+id/image_editor_track_play"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:padding="8dp"
    android:src="@drawable/ic_rounded_play"
    android:background="?attr/selectableItemBackgroundBorderless"
    app:tint="?attr/colorOnSurfaceVariant"
    android:contentDescription="@string/sh1_camtrack_play_track"
    tools:ignore="ContentDescription" />

  <com.google.android.material.materialswitch.MaterialSwitch
    android:id="@+id/switch_editor_track_enabled"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="8dp" />

</LinearLayout>
