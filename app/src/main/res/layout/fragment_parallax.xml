<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:transitionGroup="true"
  android:background="?attr/colorSurface">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar_parallax"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar_parallax"
      style="@style/Widget.Doodle.Toolbar.Back"
      app:title="@string/sh1_title_parallax"
      app:menu="@menu/menu_main" />

  </com.google.android.material.appbar.AppBarLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/scroll_parallax"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/constraint_parallax"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingTop="16dp"
      android:paddingBottom="8dp">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/max_content_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
          android:id="@+id/linear_environment_tilt"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_tilt"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_drag_pan_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_tilt" />

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_tilt_description" />

          </LinearLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_environment_tilt"
            style="@style/Widget.Doodle.Switch"
            tools:ignore="DuplicateSpeakableTextCheck" />

        </LinearLayout>

        <LinearLayout
          android:id="@+id/linear_environment_tilt_threshold"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_tilt_threshold"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_straighten"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_tilt_threshold" />

            <TextView
              android:id="@+id/text_environment_tilt_threshold_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_tilt_threshold_description" />

          </LinearLayout>

        </LinearLayout>

        <com.google.android.material.slider.Slider
          android:id="@+id/slider_environment_tilt_threshold"
          style="@style/Widget.Doodle.Slider"
          android:layout_marginStart="68dp"
          android:layout_marginEnd="20dp"
          android:valueFrom="5"
          android:valueTo="45"
          android:stepSize="1"
          tools:ignore="DuplicateSpeakableTextCheck" />

        <LinearLayout
          android:id="@+id/linear_environment_tilt_max"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine">

          <ImageView
            android:id="@+id/image_environment_tilt_max"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_rotate_right_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_tilt_max" />

            <TextView
              android:id="@+id/text_environment_tilt_max_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_tilt_max_description" />

          </LinearLayout>

        </LinearLayout>

        <com.google.android.material.slider.Slider
          android:id="@+id/slider_environment_tilt_max"
          style="@style/Widget.Doodle.Slider"
          android:layout_marginStart="68dp"
          android:layout_marginEnd="20dp"
          android:valueFrom="1"
          android:valueTo="20"
          android:stepSize="0.5"
          tools:ignore="DuplicateSpeakableTextCheck" />

        <LinearLayout
          android:id="@+id/linear_environment_tilt_rate"
          style="@style/Widget.Doodle.LinearLayout.ListItem.TwoLine.Clickable">

          <ImageView
            android:id="@+id/image_environment_tilt_rate"
            style="@style/Widget.Doodle.ImageView.ListItem.Icon"
            android:src="@drawable/ic_rounded_timer_anim"
            tools:ignore="ContentDescription" />

          <LinearLayout style="@style/Widget.Doodle.LinearLayout.ListItem.TextBox.Stretch">

            <TextView
              style="@style/Widget.Doodle.TextView.ListItem.Title"
              android:text="@string/sh1_tilt_rate" />

            <TextView
              android:id="@+id/text_environment_tilt_rate_value"
              style="@style/Widget.Doodle.TextView.ListItem.Description"
              android:text="@string/sh1_tilt_rate_description" />

          </LinearLayout>

        </LinearLayout>
      </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
